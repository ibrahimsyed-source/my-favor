{
  "expo": {
    "name": "My Favor",
    "slug": "my-favor-1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myfavor",
    "userInterfaceStyle": "light",
    "description": "A peer-to-peer favor exchange app",
    "primaryColor": "#ED1C24",
    "privacy": "public",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myfavrapp.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false,
        "googleMapsApiKey": "AIzaSyB9vKASqiPS-xWAVBy5YlqOJLEvLwpA6iw"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "My Favor needs access to your photos so you can add an image to a favor request or set your profile picture.",
        "NSCameraUsageDescription": "My Favor needs access to your camera so you can take a photo for a favor request or your profile picture.",
        "NSLocationWhenInUseUsageDescription": "My Favor uses your location while you're completing a favor so the member can see how far away their Favor Pal is."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.myfavrapp.app",
      "versionCode": 2,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB9vKASqiPS-xWAVBy5YlqOJLEvLwpA6iw"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "My Favor needs access to your photos so you can add an image to a favor request or set your profile picture.",
          "cameraPermission": "My Favor needs access to your camera so you can take a photo for a favor request or your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "My Favor uses your location while you're completing a favor so the member can see how far away their Favor Pal is."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED1C24"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4953426c-879b-4b41-b32b-ae626a2a6a46"
      }
    },
    "owner": "my-favor-app-1"
  }
}
