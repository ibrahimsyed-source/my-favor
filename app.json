{
  "expo": {
    "name": "My Favor",
    "slug": "my-favor-1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myfavor",
    "userInterfaceStyle": "light",
    "description": "A peer-to-peer favor exchange app",
    "primaryColor": "#ED1C24",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myfavorapp.app",
      "buildNumber": "12",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "My Favor needs access to your photos so you can add an image to a favor request or set your profile picture.",
        "NSCameraUsageDescription": "My Favor needs access to your camera so you can take a photo for a favor request or your profile picture.",
        "NSLocationWhenInUseUsageDescription": "My Favor uses your location while you're completing a favor so the member can see how far away their Favor Pal is.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "My Favor shares your location in the background while you're completing a favor so the member can watch their Favor Pal approach in real time, even when the app isn't open.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.myfavorapp.app",
      "versionCode": 2,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAuYSwh68dGniO5-CuPzokwdiv0EExcKMY"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "My Favor needs access to your photos so you can add an image to a favor request or set your profile picture.",
          "cameraPermission": "My Favor needs access to your camera so you can take a photo for a favor request or your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "My Favor uses your location while you're completing a favor so the member can see how far away their Favor Pal is.",
          "locationAlwaysAndWhenInUsePermission": "My Favor shares your location in the background while you're completing a favor so the member can watch their Favor Pal approach in real time, even when the app isn't open.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED1C24"
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.33.0"
        }
      ],
      [
        "@rnmapbox/navigation",
        {
          "locationWhenInUsePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4953426c-879b-4b41-b32b-ae626a2a6a46"
      }
    },
    "owner": "my-favor-app-1"
  }
}
